#!/bin/sh
# Git Flow guard: enforce the Conventional Commits format
# Enforces .cursor/rules/git_flow.mdc

msg_file="$1"
first_line=$(head -n1 "$msg_file" 2>/dev/null)

# Merge commits and the like pass through
case "$first_line" in
  Merge\ *)
    exit 0
    ;;
  "")
    echo "⚠️  The commit message is empty."
    exit 1
    ;;
esac

# Conventional Commits: type(scope)?: subject
# type: feat, fix, docs, style, refactor, test, chore
if echo "$first_line" | grep -qE '^(feat|fix|docs|style|refactor|test|chore)(\([^)]*\))?: .+'; then
  exit 0
fi

echo ""
echo "⚠️  The commit message must follow the Conventional Commits format."
echo ""
echo "  Examples: \"feat: add new feature\", \"fix: correct login bug\""
echo "  type: feat, fix, docs, style, refactor, test, chore"
echo ""
echo "First line: $first_line"
echo ""
exit 1
