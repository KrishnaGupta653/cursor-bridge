#!/bin/sh
# Git Flow guard: block commits on main/develop/dev
# Enforces .cursor/rules/git_flow.mdc
# Merge commits (e.g. from git flow feature finish) are allowed

# Allow while a merge is in progress (git flow feature finish creates a merge commit on develop)
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  exit 0
fi

branch=$(git branch --show-current 2>/dev/null)
case "$branch" in
  main|develop|dev)
    echo ""
    echo "⚠️  Git Flow violation: you cannot commit directly to the main, develop or dev branch."
    echo ""
    echo "Create a feature/bugfix branch first:"
    echo "  git flow feature start <feature-name>   # new feature"
    echo "  git flow bugfix start <bugfix-name>    # bug fix"
    echo ""
    exit 1
    ;;
  *)
    exit 0
    ;;
esac
